{
	"name": "obsidian-privatus-analytics",
	"version": "1.0.0",
	"description": "Show live website stats from Privatus Analytics in your notes.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --test test/*.test.ts"
	},
	"keywords": ["obsidian", "analytics", "privacy", "cookieless"],
	"author": "Privatus Analytics",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
